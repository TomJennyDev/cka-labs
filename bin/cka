#!/usr/bin/env bash
# cka: chạy lab trong repo cka-labs
#   cka list                 liệt kê lab
#   cka setup <lab> [stage]  tạo tình huống ban đầu của lab
#   cka verify <lab>         chấm bài
#   cka reset <lab>          dọn dẹp tài nguyên của lab
#   cka solution <lab>       xem lời giải
#   cka open <lab>           xem đề bài
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)

usage() {
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
}

find_lab() {
  local q="$1" d
  [[ "$q" =~ ^[0-9]$ ]] && q="0$q"
  for d in "$ROOT"/labs/"$q"*; do
    [[ -d "$d" ]] && { echo "$d"; return 0; }
  done
  echo "Không tìm thấy lab '$1'. Chạy: cka list" >&2
  return 1
}

pager() { if command -v less >/dev/null && [[ -t 1 ]]; then less -R "$1"; else cat "$1"; fi; }

cmd="${1:-}"; shift || true
case "$cmd" in
  list|ls)
    for d in "$ROOT"/labs/*/; do
      n=$(basename "$d")
      t=$(sed -n '1s/^# //p' "$d/README.md" 2>/dev/null)
      printf '  %-34s %s\n' "$n" "$t"
    done ;;
  setup)    d=$(find_lab "${1:?thiếu số lab}"); shift; bash "$d/setup.sh" "$@" ;;
  verify|check) d=$(find_lab "${1:?thiếu số lab}"); bash "$d/verify.sh" ;;
  reset|cleanup) d=$(find_lab "${1:?thiếu số lab}"); bash "$d/cleanup.sh" ;;
  solution|sol) d=$(find_lab "${1:?thiếu số lab}"); pager "$d/SOLUTION.md" ;;
  open|show|read) d=$(find_lab "${1:?thiếu số lab}"); pager "$d/README.md" ;;
  ""|-h|--help|help) usage ;;
  *) echo "Lệnh không hợp lệ: $cmd" >&2; usage; exit 1 ;;
esac
