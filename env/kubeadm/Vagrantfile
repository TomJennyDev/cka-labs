# 3 máy ảo Ubuntu 24.04 cho các lab cần cluster kubeadm thật (cài đặt, nâng cấp, HA).
#   vagrant up            # tạo cp-1, worker-1, worker-2 (khoảng 10 phút)
#   vagrant ssh cp-1      # làm lab từ cp-1
# Provider: VirtualBox (mặc định), libvirt hoặc Parallels/VMware (máy Apple Silicon).
K8S_MINOR = ENV.fetch("K8S_MINOR", "1.36")   # bắt đầu từ 1.36 để có bài nâng cấp lên 1.37
NODES = { "cp-1" => "192.168.56.10", "worker-1" => "192.168.56.11", "worker-2" => "192.168.56.12" }
# HA=1 thêm 2 control plane cho lab 32:  HA=1 vagrant up cp-2 cp-3
NODES.merge!("cp-2" => "192.168.56.13", "cp-3" => "192.168.56.14") if ENV["HA"] == "1"

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  NODES.each do |name, ip|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: ip
      node.vm.provider "virtualbox" do |vb|
        vb.cpus = 2
        vb.memory = name.start_with?("cp") ? 2560 : 2048
      end
      node.vm.provider "libvirt" do |lv|
        lv.cpus = 2
        lv.memory = name.start_with?("cp") ? 2560 : 2048
      end
      node.vm.provision "shell", path: "prepare-node.sh", env: { "K8S_MINOR" => K8S_MINOR, "NODE_IP" => ip }
    end
  end
end
